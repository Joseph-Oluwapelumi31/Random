{
  "name": "vamsi-reddy-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['.next','node_modules/.cache'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "rebuild": "npm run clean && npm run build",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:3000": "node scripts/kill-port.mjs 3000 && next dev -p 3000 -H 0.0.0.0",
    "dev:fresh": "npm run clean && next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "prestart": "node scripts/ensure-next-build.mjs",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "verify:site": "playwright test",
    "verify:site:headed": "playwright test --headed",
    "verify:logos": "playwright test e2e/affiliation-logos.spec.ts --project=chromium-desktop",
    "verify:sanity": "node scripts/verify-sanity-sync.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@portabletext/react": "^3.2.4",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.11",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-toast": "^1.2.11",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@sanity/client": "^6.28.2",
    "@sanity/image-url": "^1.1.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.507.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.2",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.171.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@emergentbase/visual-edits": "https://assets.emergent.sh/npm/emergentbase-visual-edits-1.0.8.tgz",
    "@playwright/test": "^1.51.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
